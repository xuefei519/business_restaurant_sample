---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as keyof typeof ui;
const t = ui[currentLang];
---

<Layout title={`Maple Dine | ${(t as any)['nav.contact']}`} lang={currentLang} isHome={false}>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 mt-12">
		<div class="text-center mb-16">
			<h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white tracking-tight mb-6">
				{(t as any)['contact.title']}
			</h1>
			<div class="w-24 h-1 bg-neon mx-auto"></div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
			{/* Contact Information */}
			<div class="space-y-12">
				<div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none border border-zinc-100 dark:border-zinc-800">
					<div class="flex items-start space-x-6">
						<div class="w-14 h-14 bg-neon/10 rounded-xl flex items-center justify-center flex-shrink-0">
							<svg class="w-7 h-7 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">{(t as any)['contact.visit.title']}</h3>
							<p class="text-zinc-600 dark:text-zinc-400 whitespace-pre-line leading-relaxed">
								{(t as any)['contact.visit.desc']}
							</p>
						</div>
					</div>
				</div>

				<div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none border border-zinc-100 dark:border-zinc-800">
					<div class="flex items-start space-x-6">
						<div class="w-14 h-14 bg-neon/10 rounded-xl flex items-center justify-center flex-shrink-0">
							<svg class="w-7 h-7 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">{(t as any)['contact.hours.title']}</h3>
							<p class="text-zinc-600 dark:text-zinc-400 whitespace-pre-line leading-relaxed">
								{(t as any)['contact.hours.desc']}
							</p>
						</div>
					</div>
				</div>

				<div class="bg-white dark:bg-zinc-900 p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] dark:shadow-none border border-zinc-100 dark:border-zinc-800">
					<div class="flex items-start space-x-6">
						<div class="w-14 h-14 bg-neon/10 rounded-xl flex items-center justify-center flex-shrink-0">
							<svg class="w-7 h-7 text-neon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
						</div>
						<div>
							<h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">{(t as any)['contact.reservations.title']}</h3>
							<p class="text-zinc-600 dark:text-zinc-400 whitespace-pre-line leading-relaxed">
								{(t as any)['contact.reservations.desc']}
							</p>
						</div>
					</div>
				</div>
			</div>

			{/* Contact Form */}
			<div class="bg-white dark:bg-zinc-900 p-10 rounded-3xl shadow-[0_20px_50px_rgb(0,0,0,0.05)] dark:shadow-none border border-zinc-100 dark:border-zinc-800">
				<form class="space-y-8">
					<div class="space-y-2">
						<label for="name" class="block text-sm font-bold text-zinc-900 dark:text-white uppercase tracking-wider">{(t as any)['contact.form.name']}</label>
						<input 
							type="text" 
							id="name" 
							class="w-full px-5 py-4 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl focus:ring-2 focus:ring-neon focus:border-neon outline-none transition-all text-zinc-900 dark:text-white placeholder-zinc-400"
							placeholder="John Doe"
						/>
					</div>
					
					<div class="space-y-2">
						<label for="email" class="block text-sm font-bold text-zinc-900 dark:text-white uppercase tracking-wider">{(t as any)['contact.form.email']}</label>
						<input 
							type="email" 
							id="email" 
							class="w-full px-5 py-4 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl focus:ring-2 focus:ring-neon focus:border-neon outline-none transition-all text-zinc-900 dark:text-white placeholder-zinc-400"
							placeholder="john@example.com"
						/>
					</div>
					
					<div class="space-y-2">
						<label for="message" class="block text-sm font-bold text-zinc-900 dark:text-white uppercase tracking-wider">{(t as any)['contact.form.message']}</label>
						<textarea 
							id="message" 
							rows="5" 
							class="w-full px-5 py-4 bg-zinc-50 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-xl focus:ring-2 focus:ring-neon focus:border-neon outline-none transition-all text-zinc-900 dark:text-white placeholder-zinc-400 resize-none"
							placeholder="How can we help you?"
						></textarea>
					</div>
					
					<button 
						type="submit" 
						class="w-full py-5 px-8 bg-neon hover:bg-neon-hover text-white font-black rounded-xl transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-neon/25 shadow-neon/10 flex items-center justify-center space-x-2"
					>
						<span>{(t as any)['contact.form.submit']}</span>
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
					</button>
				</form>
			</div>
		</div>
	</div>
</Layout>
