---
import Layout from '../../layouts/Layout.astro';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as keyof typeof ui;
const t = ui[currentLang];
const menuItems = (t as any).menuItems || [];
---

<Layout title={`Maple Dine | ${(t as any)['nav.menu']}`} lang={currentLang} isHome={false}>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 mt-12">
		<div class="text-center mb-20">
			<h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white tracking-tight mb-6">
				{(t as any)['nav.menu']}
			</h1>
			<div class="w-24 h-1 bg-neon mx-auto"></div>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-16">
			{menuItems.map((item: any) => (
				<div class="group">
					<div class="relative overflow-hidden rounded-2xl mb-6 shadow-lg aspect-[4/3]">
						<img 
							src={item.image} 
							alt={item.title} 
							class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						<div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-4 py-2 rounded-full font-black text-zinc-900 shadow-lg">
							{item.price}
						</div>
					</div>
					
					<div class="px-2">
						<div class="flex justify-between items-start mb-3">
							<h3 class="text-2xl font-bold text-zinc-900 dark:text-white group-hover:text-amber-500 transition-colors">
								{item.title}
							</h3>
						</div>
						
						<p class="text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed">
							{item.description}
						</p>
						
						<div class="mt-4 flex items-center space-x-1">
							{Array.from({ length: 5 }).map((_, i) => (
								<svg 
									class={`w-5 h-5 ${i < item.rating ? 'text-amber-500' : 'text-zinc-300 dark:text-zinc-700'}`} 
									fill="currentColor" 
									viewBox="0 0 20 20"
								>
									<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
								</svg>
							))}
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</Layout>
