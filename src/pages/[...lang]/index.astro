---
import Layout from '../../layouts/Layout.astro';
import { MenuCard } from '../../components/MenuCard';
import { ArticleCard } from '../../components/ArticleCard';
import { ui } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'fr' } }
  ];
}

const { lang } = Astro.params;
const currentLang = (lang || 'en') as keyof typeof ui;
const t = ui[currentLang];

const menuItems = (t as any).menuItems || [];
const articles = (t as any).articles || [];

const avatars = Array(12).fill('https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=100');
---

<Layout title={`Maple Dine | ${(t as any)['nav.home']}`} lang={currentLang} isHome={true}>
	{/* Hero Section */}
	<div class="relative w-full h-screen bg-zinc-900 flex flex-col justify-center items-center overflow-hidden">
		{/* Background Image */}
		<div class="absolute inset-0 z-0">
			<img 
				src="https://images.unsplash.com/photo-1469041797191-50ace28483c3?auto=format&fit=crop&q=80" 
				alt="Hero Maple Landscape or Food" 
				class="w-full h-full object-cover opacity-60 mix-blend-overlay"
			/>
		</div>
		
		{/* Main Title */}
		<div class="relative z-10 text-center w-full px-4 -mt-20">
			<h1 class="text-[12vw] leading-[0.85] font-black text-neon tracking-tighter mix-blend-normal drop-shadow-2xl">
				{(t as any)['hero.title'].split('\n').map((line: string) => (
					<>{line}<br/></>
				))}
			</h1>
		</div>

		{/* Bottom Info Blocks */}
		<div class="absolute bottom-10 left-0 right-0 z-10 px-4 md:px-12 flex flex-col md:flex-row justify-between items-end">
			<div class="bg-black/40 backdrop-blur-md border border-white/10 rounded-sm p-4 w-full md:w-auto mb-4 md:mb-0">
				<div class="flex justify-between items-center space-x-12 border-b border-white/20 pb-2 mb-2 text-white">
					<span class="font-bold">{(t as any)['hero.day1']}</span>
					<span>{(t as any)['hero.hours']}</span>
				</div>
				<div class="flex justify-between items-center space-x-12 text-white/70">
					<span class="font-bold">{(t as any)['hero.day2']}</span>
					<span>{(t as any)['hero.hours']}</span>
				</div>
			</div>
			
			<div class="max-w-xs text-white/90 text-sm font-medium text-right shadow-black drop-shadow-lg">
				{(t as any)['hero.subtitle']}
			</div>
		</div>
	</div>

	{/* Intro & Stats Section */}
	<section class="relative bg-neon pt-28 pb-20 px-4 text-center">
		{/* Overlapping Images */}
		<div class="absolute left-1/2 -translate-x-1/2 -top-16 flex justify-center items-center shadow-2xl">
			<img src="https://images.unsplash.com/photo-1544148103-0773bf10d330?auto=format&fit=crop&q=80&w=200" alt="Intro 1" class="w-24 h-20 md:w-32 md:h-24 object-cover rounded-xl border-4 border-neon shadow-lg transform -rotate-6 z-10" />
			<img src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&q=80&w=200" alt="Intro 2" class="w-32 h-24 md:w-40 md:h-28 object-cover rounded-xl border-4 border-neon shadow-2xl z-20 -mx-4" />
			<img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?auto=format&fit=crop&q=80&w=200" alt="Intro 3" class="w-24 h-20 md:w-32 md:h-24 object-cover rounded-xl border-4 border-neon shadow-lg transform rotate-6 z-10" />
		</div>

		<div class="max-w-4xl mx-auto z-10 relative">
			<h2 class="text-2xl md:text-3xl lg:text-4xl font-black text-black leading-tight mb-16 tracking-tight">
				{(t as any)['intro.title']}
			</h2>
			
			<div class="flex flex-col md:flex-row justify-center items-center gap-8 md:gap-16 border-t border-black/10 pt-8">
				<div class="flex items-center space-x-2 text-black text-lg md:text-xl">
					<span class="font-black text-2xl">10,000+</span>
					<span class="font-medium">{(t as any)['stats.customers']}</span>
				</div>
				<div class="flex items-center space-x-2 text-black text-lg md:text-xl">
					<span class="font-black text-2xl">200+</span>
					<span class="font-medium">{(t as any)['stats.menu']}</span>
				</div>
				<div class="flex items-center space-x-2 text-black text-lg md:text-xl">
					<span class="font-black text-2xl">95%</span>
					<span class="font-medium">{(t as any)['stats.healthier']}</span>
				</div>
			</div>
		</div>
	</section>

	{/* Menu Section */}
	<section class="bg-zinc-900 py-24 px-4 sm:px-6 lg:px-8 rounded-t-[3rem] -mt-10 relative z-20 shadow-[0_-20px_50px_rgba(0,0,0,0.5)]">
		<div class="max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16">
				<div class="max-w-2xl">
					<h2 class="text-4xl md:text-5xl font-black text-white leading-tight mb-4 tracking-tight">
						{(t as any)['menu.title'].split('\n').map((line: string) => (
							<>{line}<br/></>
						))}
					</h2>
					<p class="text-zinc-400 text-sm md:text-base max-w-sm">
						{(t as any)['menu.subtitle']}
					</p>
				</div>
				<div class="mt-6 md:mt-0">
					<span class="bg-neon text-white text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-sm">
						{(t as any)['menu.badge']}
					</span>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gap-y-12">
				{menuItems.map((item: any) => (
					<MenuCard {...item} />
				))}
			</div>
		</div>
	</section>

	{/* Testimonial Section */}
	<section class="bg-neon py-24 px-4 overflow-hidden rounded-t-[3rem] -mt-10 relative z-30 shadow-[0_-20px_50px_rgba(0,0,0,0.3)]">
		<div class="max-w-5xl mx-auto text-center relative z-10 mb-16">
			<h2 class="text-2xl md:text-4xl lg:text-5xl font-black text-black leading-tight tracking-tight mb-6">
				{(t as any)['testimonial.quote']}
			</h2>
			<p class="text-black font-medium text-lg">
				{(t as any)['testimonial.author']}
			</p>
		</div>
		
		{/* Avatars Row */}
		<div class="w-full flex justify-center -space-x-4 px-4">
			<div class="flex overflow-hidden pb-4">
				{avatars.map((avatar, i) => (
					<div class="w-12 h-12 md:w-16 md:h-16 rounded-full border-2 border-neon overflow-hidden flex-shrink-0 shadow-lg" style={`z-index: ${20-i}`}>
						<img src={avatar} alt={`User ${i}`} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all cursor-pointer" />
					</div>
				))}
			</div>
		</div>
	</section>

	{/* Discover Section */}
	<section class="bg-neon pb-32 px-4 sm:px-6 lg:px-8">
		<div class="max-w-7xl mx-auto">
			<div class="flex flex-col md:flex-row justify-between items-end mb-12">
				<div class="max-w-md mb-6 md:mb-0">
					<h2 class="text-4xl md:text-5xl font-black text-black leading-tight tracking-tight mb-4">
						{(t as any)['discover.title'].split('\n').map((line: string) => (
							<>{line}<br/></>
						))}
					</h2>
					<p class="text-black/80 font-medium text-sm">
						{(t as any)['discover.description']}
					</p>
				</div>
				<div class="flex space-x-2">
					<button class="w-10 h-10 rounded-full bg-white flex justify-center items-center hover:bg-zinc-200 transition-colors shadow-md">
						<svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M15 19l-7-7 7-7"></path></svg>
					</button>
					<button class="w-10 h-10 rounded-full bg-zinc-900 border border-zinc-900 flex justify-center items-center hover:bg-black transition-colors shadow-md text-neon">
						<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M9 5l7 7-7 7"></path></svg>
					</button>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{articles.map((article: any) => (
					<ArticleCard {...article} />
				))}
			</div>
		</div>
	</section>
</Layout>
